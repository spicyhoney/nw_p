# Local defaults. These adapters do not require AWS credentials.
APP_ENV=local
MODEL_PROVIDER=mock
TOOL_TRANSPORT=local
OBJECT_STORAGE=local
DATABASE_URL=postgresql://home_repair:home_repair@localhost:5432/home_repair
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
WEB_MODEL_PROVIDER=mock
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Optional hosted open-model mode for the terminal demo. Export HF_TOKEN in the
# current shell instead of saving a real token in this file.
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
HF_PROVIDER=auto
HF_MAX_TOKENS=512
HF_TIMEOUT_SECONDS=60

# Competition environment. Fill only after the organizer provides the account,
# Region and resources. Never put access keys or secret keys in this file.
AWS_REGION=
BEDROCK_MODEL_ID=
AGENTCORE_GATEWAY_URL=
S3_BUCKET=
