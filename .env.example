# Local defaults. These adapters do not require AWS credentials.
APP_ENV=local
MODEL_PROVIDER=mock
OBJECT_STORAGE=local
DATABASE_URL=postgresql://home_repair:home_repair@localhost:5432/home_repair
WEB_CASE_REPOSITORY=memory
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
WEB_MODEL_PROVIDER=mock
WEB_MEDIA_PROVIDER=none
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Select where read-only MCP tools run. `local` is the default local FastMCP
# path. `agentcore_remote_mcp` connects to a short-lived AWS AgentCore Runtime
# and fails closed if configuration, credentials, or connection are missing.
# Never put a real runtime ARN, account ID, access key, or token in this file.
TOOL_TRANSPORT=local
AGENTCORE_RUNTIME_ARN=
AGENTCORE_REGION=us-west-2
AGENTCORE_QUALIFIER=DEFAULT

# Optional Bedrock text mode. Credentials come from the standard AWS credential
# chain, never from this file.
BEDROCK_REGION=
BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=512
BEDROCK_TIMEOUT_SECONDS=60

# Optional hosted open-model mode for the terminal demo. Export HF_TOKEN in the
# current shell instead of saving a real token in this file.
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
HF_PROVIDER=auto
HF_MAX_TOKENS=512
HF_TIMEOUT_SECONDS=60

# Optional repair-photo analysis. The image is sent to the selected Hugging Face
# Inference Provider only after the user explicitly confirms external processing.
# Keep real tokens in the shell/secret manager, never in this file.
HF_VL_MODEL_ID=Qwen/Qwen3-VL-30B-A3B-Instruct
HF_VL_PROVIDER=auto
HF_VL_MAX_TOKENS=512
HF_VL_TIMEOUT_SECONDS=60
MEDIA_ROOT=var/media

# HF-only 台語／國語語音輸入。預設 Space 公開且不需 token；若改用 private Space，
# 只設定獨立 HF_ASR_TOKEN，禁止把 HF_TOKEN 隱含轉送給社群 Space。
HF_ASR_SPACE_URL=https://liaozike-breeze-asr-api.hf.space
HF_ASR_API_NAME=transcribe
HF_ASR_AUDIO_PARAMETER=audio
HF_ASR_MODEL_ID=MediaTek-Research/Breeze-ASR-26
HF_ASR_TIMEOUT_SECONDS=90
HF_ASR_EXTRA_INPUTS_JSON={}
HF_ASR_TOKEN=

# Optional exact-IP allowlist for a short-lived public Demo. Leave these lines
# commented for normal local use; Cloudflare forwarding must never be trusted
# unless the app is actually behind the controlled tunnel/proxy.
# DEMO_ALLOWED_IPS=203.0.113.10,203.0.113.11
# DEMO_TRUST_CF_CONNECTING_IP=false
